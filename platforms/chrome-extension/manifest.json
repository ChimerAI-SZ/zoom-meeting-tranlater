{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "BabelAI",
  "description": "__MSG_extensionDescription__",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "author": "BabelAI Team",
  "homepage_url": "https://github.com/YOUR-ORG/s2s",
  "privacy_policy": "https://babelai.app/privacy.html",
  "default_locale": "en",
  "action": {
    "default_title": "BabelAI - Real-time Translation",
    "default_popup": "popup/popup-new.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "scripting",
    "activeTab",
    "alarms",
    "tabs"
  ],
  "host_permissions": []
}
